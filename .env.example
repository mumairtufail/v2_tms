APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Times are stored in UTC and shown in this zone everywhere (screens, logs, emails, PDFs).
APP_DISPLAY_TIMEZONE=America/Edmonton
APP_DISPLAY_TIMEZONE_LABEL="Mountain Time"
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Checks that an address's domain can actually receive mail before accepting it.
# Costs one DNS lookup per submitted address and fails closed, so set it to false
# where there is no outbound DNS (offline development, CI).
MAIL_VALIDATE_DNS=true
# Reject domains that have no MX record (parked domains that cannot take mail).
MAIL_REQUIRE_MX=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Audit trail
# Proxies in front of the app, comma separated, or * when the app is only
# reachable through them. Unset means X-Forwarded-For is ignored and logged
# IPs will be the proxy, not the client.
TRUSTED_PROXIES=
AUDIT_ENABLED=true
AUDIT_LOG_READS=true
AUDIT_RETENTION_DAYS=365
AUDIT_READ_RETENTION_DAYS=30

AUDIT_TECHNICAL_RETENTION_DAYS=30
AUDIT_DEFERRED_WRITES=true
# AUDIT_DB_CONNECTION=audit   # move the table to its own connection at scale
