<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!--
            Tests use RefreshDatabase, which runs migrate:fresh. With this
            commented out it ran against whatever DB_DATABASE pointed at, so
            running the suite destroyed the developer's local data.

            It stays on MySQL rather than sqlite because the migrations use
            MySQL-specific DDL (ALTER ... MODIFY, information_schema) and
            ->change(), which sqlite cannot run without doctrine/dbal.

            Create it once:  CREATE DATABASE tms_testing;
        -->
        <env name="DB_DATABASE" value="tms_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <!--
            Address validation falls back to syntax only. The DNS check in
            App\Support\EmailRules fails closed, and the example.com addresses
            the suite uses have no MX record, so every one of them would be
            rejected. config/mail.php documents turning it off for CI.
        -->
        <env name="MAIL_VALIDATE_DNS" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
